# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# CORS & CSRF Settings
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database Settings (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/ecom_db
POSTGRES_DB=ecom_db
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email / SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=ecommerce <noreply@ecommerce.uz>

# Superuser (created automatically on container start if it doesn't exist)
DJANGO_SUPERUSER_EMAIL=admin@ecommerce.uz
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=User

# Payment Gateways Configuration
PAYME_MERCHANT_ID=test_merchant_id
PAYME_SECRET_KEY=test_secret_key
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

CLICK_SERVICE_ID=test_service_id
CLICK_MERCHANT_ID=test_merchant_id
CLICK_SECRET_KEY=test_secret_key
CLICK_MERCHANT_USER_ID=test_merchant_user_id
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

UZUM_MERCHANT_ID=test_uzum_merchant_id
UZUM_SECRET_KEY=test_uzum_secret_key
UZUM_CHECKOUT_URL=https://www.uzumbank.uz/open-service
