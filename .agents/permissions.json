{
  "$schema": "https://antigravity.google/schemas/permissions.json",
  "permissions": {
    "allow": [
      "read_file(.agents/**)",
      "write_file(.agents/**)",
      "read_file(plans/**)",
      "write_file(plans/**)",
      "command(python manage.py *)",
      "command(python manage.py test*)",
      "command(python manage.py runserver*)",
      "command(python manage.py check*)",
      "command(python manage.py makemigrations*)",
      "command(python manage.py migrate*)",
      "command(pytest*)",
      "command(python -m unittest*)",
      "command(grep *)",
      "command(egrep *)",
      "command(fgrep *)",
      "command(find *)",
      "command(rg *)",
      "command(git *)"
    ],
    "ask": [],
    "deny": [
      "command(rm -rf /)",
      "command(rm -rf ~)"
    ]
  }
}
