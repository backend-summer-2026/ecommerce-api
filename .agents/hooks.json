{
  "project-permissions": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ./hooks/sync_permissions.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/check_permission_hook.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
